# py/ingestion/.env.example — bootstrap + secrets ONLY.
# Copy to .env for local standalone runs; in the compose stack these come from
# infra/self_hosted/.env. DB is the single source of truth for scan behaviour — what to scan,
# how often, who is enrolled — none of that lives here (see spec §6).

# ── Database (the shared STASH Postgres; ingestion reads/writes the same `stash` DB) ─────────
# Either set a single DATABASE_URL, or the discrete DB_* parts below.
# DATABASE_URL=postgresql+psycopg://stash:pwd@localhost:7432/stash
DB_HOST=localhost
DB_PORT=7432
DB_NAME=stash
DB_USER=stash
DB_PASSWORD=change-me

# ── Token broker (user_engine) ───────────────────────────────────────────────
# Base URL of user_engine (7xxx port convention).
USER_ENGINE_BASE_URL=http://localhost:7083
# Shared secret presented as X-Internal-Auth on user_engine /internal/** calls. SECRET —
# must match user_engine's INTERNAL_SVC_TOKEN. Never commit a real value.
INTERNAL_SVC_TOKEN=change-me

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO

# ── Scheduler knobs (optional; mechanical, not product config) ───────────────
# How often the scheduler re-reads scan_sources from the DB.
# POLL_INTERVAL_SECONDS=60
# Margin subtracted from the watermark for the Gmail `after:` bound (clock skew / late mail).
# GMAIL_SKEW_SECONDS=300
