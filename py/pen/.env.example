# py/pen/.env.example — bootstrap + secrets ONLY.
# Copy to .env for local standalone runs; in the compose stack these come from
# infra/self_hosted/.env. The source registry (which sources exist / are enabled) lives in the
# shared DB (`scan_sources`); parse cadence + retry knobs live in code
# (parse_handler_config.py). Neither belongs here (spec §6).

# ── Database (the shared STASH Postgres; pen reads/writes the same `stash` DB) ───────────────
# Either set a single DATABASE_URL, or the discrete DB_* parts below.
# DATABASE_URL=postgresql+psycopg://stash:pwd@localhost:7432/stash
DB_HOST=localhost
DB_PORT=7432
DB_NAME=stash
DB_USER=stash
DB_PASSWORD=change-me

# ── LLM secrets (API keys ONLY) ──────────────────────────────────────────────────────────────
# Each handler picks its OWN provider + model + endpoint in CODE (parse_handler_config.py), so
# Swiggy can run on Groq while Paytm runs on OpenRouter / NVIDIA / a local model. Only the
# SECRETS live here — one API key per provider you actually use. A handler's LLMSettings names
# which key env var it needs (e.g. swiggy_instamart → GROQ_API_KEY). A local/keyless endpoint
# needs no key. NEVER commit a real value and NEVER log it.
GROQ_API_KEY=change-me
# OPENROUTER_API_KEY=change-me
# NVIDIA_API_KEY=change-me
# (Any env var ending in _API_KEY is captured; add one per provider a handler uses.)

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO
