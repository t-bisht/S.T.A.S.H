# Copy to infra/self_hosted/.env before `docker compose up`.
# This file is a template — real .env should be gitignored.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
PG_DATABASE=stash
PG_USER=stash
PG_PASSWORD=change-me

# ── user_engine ↔ Hiemdall back-channel ─────────────────────────────────────
# Shared secret for X-Internal-Auth on POST /internal/auth/exchange.
# Must be identical on both sides. Generate: openssl rand -hex 32
INTERNAL_SVC_TOKEN=change-me

# AES-GCM key for stored refresh_token + access_token (base64, 32 bytes).
# Generate: openssl rand -base64 32
STASH_TOKEN_ENC_KEY=change-me

# ── stash-user-engine (compose/backend.yml) ─────────────────────────────────
# Hiemdall location reachable from inside the compose stack. Over the shared
# bridge network `tb-shared`, use the Hiemdall container name.
HIEMDALL_BASE_URL=http://hiemdall:9082
HIEMDALL_APP_ID=stash

# SPA origin for CORS allow-list. Comma-separated for multiple origins.
# Local dev default:
VITE_USER_ENGINE_BASE_URL=http://localhost:5173

# Image tag (override to a specific version if `latest` is not desired).
STASH_USER_ENGINE_IMAGE_TAG=latest

# Host port for stash-user-engine (project convention: 7xxx).
STASH_USER_ENGINE_HOST_PORT=7083
