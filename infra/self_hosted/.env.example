# Copy to infra/self_hosted/.env before `docker compose up`.
# This file is a template — real .env should be gitignored.

# ── PostgreSQL ──────────────────────────────────────────────────────────────
PG_DATABASE=stash
PG_USER=stash
PG_PASSWORD=change-me
# Optional — compose defaults to the in-stack container (stash-postgres:5432).
# PG_HOST=stash-postgres
# PG_PORT=5432

# ── Inbound guard for user_engine /internal/** ──────────────────────────────
# Shared secret Stash backend engines present as X-Internal-Auth when they ask
# user_engine for a Google access token. Distinct from the Hiemdall token below
# (different trust boundary; rotate independently). Startup fails if blank.
# Generate: openssl rand -hex 32
INTERNAL_SVC_TOKEN=change-me

# ── user_engine → Hiemdall back-channel ─────────────────────────────────────
# Secret user_engine sends as X-Internal-Auth on POST /internal/auth/exchange
# and POST /internal/auth/google/refresh. Must match the Hiemdall side exactly.
# Generate: openssl rand -hex 32
HIEMDALL_INTERNAL_TOKEN=change-me

# AES-GCM key for stored refresh_token + access_token (base64, 32 bytes).
# Generate: openssl rand -base64 32
STASH_TOKEN_ENC_KEY=change-me

# ── stash-user-engine (compose/backend.yml) ─────────────────────────────────
# Hiemdall location reachable from inside the compose stack. Over the shared
# bridge network `tb-shared`, use the Hiemdall container name.
HIEMDALL_BASE_URL=http://hiemdall:9082
HIEMDALL_APP_ID=stash

# SPA origin for CORS allow-list. Comma-separated for multiple origins.
# Local dev default:
VITE_USER_ENGINE_BASE_URL=http://localhost:5173

# Image tag (override to a specific version if `latest` is not desired).
STASH_USER_ENGINE_IMAGE_TAG=latest

# Host port for stash-user-engine (project convention: 7xxx).
STASH_USER_ENGINE_HOST_PORT=7083

# ── Google access-token refresh sweep (TokenRefreshProperties) ──────────────
# false stops the scheduled sweep only; on-demand refresh keeps working.
# Also the no-rollback kill switch if the sweep misbehaves.
TOKEN_REFRESH_ENABLED=true
# ISO-8601 durations. Startup fails unless REFRESH_WINDOW > INTERVAL.
TOKEN_REFRESH_INTERVAL=PT10M
TOKEN_REFRESH_REFRESH_WINDOW=PT15M

# ── stash-ingestion (compose/ingestion.yml) ─────────────────────────────────
# Gmail scan & ingestion engine. Reuses INTERNAL_SVC_TOKEN above as X-Internal-Auth when it
# asks user_engine for a Google access token, and the PG_* vars for the shared `stash` DB.
# Image tag (override to pin a version if `latest` is not desired).
STASH_INGESTION_IMAGE_TAG=latest
# user_engine location reachable from inside the compose stack (backend network).
STASH_USER_ENGINE_INTERNAL_URL=http://stash-user-engine:7083
# Scheduler knobs (mechanical, not product config — scan behaviour lives in the DB).
INGESTION_POLL_INTERVAL_SECONDS=60
INGESTION_GMAIL_SKEW_SECONDS=300
INGESTION_LOG_LEVEL=INFO

# ── stash-admin-engine (compose/admin.yml) ────────────────────────────────────
# Admin console credentials. Startup fails if either is blank (@NotBlank).
# Replace the change-me value before use.
# Generate a password: openssl rand -base64 24
STASH_ADMIN_USERNAME=admin
STASH_ADMIN_PASSWORD=change-me

# Image tag (override to pin a version if `latest` is not desired).
STASH_ADMIN_IMAGE_TAG=latest
