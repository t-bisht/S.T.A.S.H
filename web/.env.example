# Runtime config is injected into /env.js by docker-entrypoint.sh at container
# start, so no VITE_* build-time envs are required for base URLs.
#
# For local dev, web/public/env.js carries the dev defaults (checked in).
# In containers, the entrypoint overwrites /env.js from these env vars:
#
#   API_BASE_URL        — prefix for apiFetch calls. Same-origin via proxy.
#                         default: /api
#   HIEMDALL_BASE_URL   — where the Google-login anchor points (hard navigation).
#                         default: http://localhost:9082
#   APP_ID              — Hiemdall ?app= query param.
#                         default: stash
#
# None of these are secrets; they land directly in window.ENV in the browser.
